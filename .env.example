# Generate a long random value for production; never commit the actual secret.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Required only for a production account/screening service (not public-information
# mode) to protect administrator TOTP MFA. Generate this once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it in the deployment secret manager, separate from FLASK_SECRET_KEY.
# SMART_SKIN_MFA_ENCRYPTION_KEY=replace-with-a-distinct-fernet-key

# Development-only convenience bootstrap. Production refuses both variables
# because service-environment passwords can be exposed or reset an account on
# every restart. Provision each production administrator in a controlled
# console instead:
#   python manage.py create-admin --email admin@example.com --enroll-mfa
# SMART_SKIN_ADMIN_EMAIL=admin@example.com
# SMART_SKIN_ADMIN_PASSWORD=replace-with-a-strong-password

# Set production only after the infrastructure and clinical release checklist is complete.
# SMART_SKIN_ENV=production

# Required only for a production account/screening service: absolute paths
# outside the project directory, on encrypted storage. Public-information mode
# deliberately does not initialise these stores.
# SMART_SKIN_DATABASE=C:\secure-data\smart-skin-users.db
# SMART_SKIN_UPLOAD_FOLDER=C:\secure-data\private-uploads
# SMART_SKIN_DATA_ENCRYPTION_AT_REST_CONFIRMED=1
# SMART_SKIN_BACKUPS_ENCRYPTED_CONFIRMED=1

# Required for every public production deployment. These values are validated
# at app startup; set only after the operational checks have been completed.
# SMART_SKIN_ALLOWED_HOSTS=hucksmartskinai.com
# SMART_SKIN_TRUSTED_PROXY_HOPS=1
# SMART_SKIN_DATA_CONTROLLER_NAME=Your legal organisation name
# SMART_SKIN_PRIVACY_CONTACT=privacy@example.com
# SMART_SKIN_PRIVACY_PROCESSORS_REVIEWED=1
# SMART_SKIN_INCIDENT_RESPONSE_CONFIRMED=1
# SMART_SKIN_RETENTION_SCHEDULER_CONFIRMED=1  # private-data/screening mode only

# Public information mode disables login, registration, upload, analysis, and
# all private routes. Production automatically enters this mode while the
# model release remains blocked; set it explicitly to publish education-only
# content.
# SMART_SKIN_PUBLIC_INFORMATION_MODE=1

# Required in production for password recovery. The public URL must be HTTPS;
# keep SMTP credentials in your deployment secret store, never in Git.
# SMART_SKIN_PUBLIC_BASE_URL=https://hucksmartskinai.com
# SMART_SKIN_SMTP_HOST=smtp.example.com
# SMART_SKIN_SMTP_PORT=587
# SMART_SKIN_SMTP_USERNAME=mailer@example.com
# SMART_SKIN_SMTP_PASSWORD=replace-with-an-app-password
# SMART_SKIN_SMTP_FROM=Smart Skin AI <no-reply@example.com>
# SMART_SKIN_SMTP_STARTTLS=1

# Required to activate a reviewed 50-class screening release. This must name
# the independent-evaluation evidence JSON whose SHA-256 is recorded in the
# matching model metadata. Its presence does not replace clinical approval.
# SMART_SKIN_MODEL_EVALUATION_MANIFEST=C:\secure-data\reviewed-model.evidence.json

# Required in production: explicit retention period for uploaded health images (1-365 days).
# SMART_SKIN_RETENTION_DAYS=30

# Required in production when the nearby-context radar is enabled: retention for
# consented coarse location/environmental context (1-168 hours).
# SMART_SKIN_LOCATION_CONTEXT_RETENTION_HOURS=24

# Use 1 only when the site is served over HTTPS.
FLASK_HTTPS=0

# Keep demonstration-only map/risk UI disabled outside local development.
SMART_SKIN_ENABLE_DEMO_FEATURES=0

# Admin training creates a candidate model only; production requires an explicit
# opt-in and an encrypted folder outside the application project.
# SMART_SKIN_ALLOW_ADMIN_TRAINING=1
# SMART_SKIN_TRAINING_CANDIDATE_FOLDER=C:\secure-data\smart-skin-candidates
# SMART_SKIN_TRAINING_PYTHON=C:\path\to\python.exe
