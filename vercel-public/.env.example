# Add these in Vercel Project Settings > Environment Variables; never commit
# real values or expose the service-role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-only-sb_secret-key
# Optional only while rotating an older project. Prefer SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-server-only-key
# Optional: private scan-image retention in days (1-365). Default: 30.
SMART_SKIN_SCAN_RETENTION_DAYS=30
