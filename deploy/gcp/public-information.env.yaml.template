# Copy outside the repository as deploy/gcp/runtime.env.yaml, fill in the two
# legal-contact values, then keep that copy out of Git. FLASK_SECRET_KEY is
# intentionally not here: Cloud Run receives it only from Secret Manager.
SMART_SKIN_ENV: production
FLASK_HTTPS: "1"
SMART_SKIN_PUBLIC_INFORMATION_MODE: "1"
# `.run.app` permits the initial Cloud Run HTTPS URL. Remove it after the
# custom-domain load balancer has passed verification.
SMART_SKIN_ALLOWED_HOSTS: hucksmartskinai.com,www.hucksmartskinai.com,.run.app
SMART_SKIN_TRUSTED_PROXY_HOPS: "1"
SMART_SKIN_PUBLIC_BASE_URL: https://hucksmartskinai.com
SMART_SKIN_DATA_CONTROLLER_NAME: REPLACE_WITH_LEGAL_DATA_CONTROLLER_NAME
SMART_SKIN_PRIVACY_CONTACT: REPLACE_WITH_PRIVACY_CONTACT_ADDRESS
SMART_SKIN_PRIVACY_PROCESSORS_REVIEWED: "1"
SMART_SKIN_INCIDENT_RESPONSE_CONFIRMED: "1"
SMART_SKIN_ENABLE_DEMO_FEATURES: "0"
