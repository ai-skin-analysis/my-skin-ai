{
  "schema_version": 2,
  "source_archive": "archive.zip",
  "purpose": "Candidate mapping from source filenames in archive.zip to the project-owner-approved 50-condition catalog. This is never a medical-label approval and must be reviewed before extraction or training.",
  "matching_policy": {
    "scope": "Only clinical image filenames are considered. Folder names alone never assign a disease label.",
