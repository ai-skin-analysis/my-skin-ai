    "excluded_filename_terms": ["histology", "pathology", "microscopic", "dermoscopy", "dermatoscope"],
    "status_for_single_match": "candidate_direct_filename_review_required",
    "status_for_multiple_matches": "needs_manual_review_multiple_candidates",
    "status_for_no_match": "unmapped_manual_review_required"
  },
